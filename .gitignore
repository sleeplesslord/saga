# Binary — anchored, or the pattern also matches the cmd/saga/ directory and
# hides every file under it.
/sg
/saga

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
vendor/

# IDE
.vscode/
.idea/
*.swp
*.swo
sg_test

# Runtime state beside any store the CLI writes to, including the repo-local
# .saga used while developing. The lock file is created on every mutation; the
# temp file is the atomic-rename staging file and only survives a crash.
*.jsonl.lock
saga-*.tmp
